#!/bin/sh
# Sync Cashew with no visible window: a Chromium window pushed off the screen edge logs in, sends the
# waiting rows inside the page, pulls down to sync, and closes. The terminal shows each step.
#   cashew-chromium          sync only (no rows sent yet: TXDB_CASHEW_SYNC_ONLY=1)
#   cashew-chromium --send   also send the waiting bank rows
#   cashew-chromium --show   use a visible window
here="$(dirname "$(readlink -f "$0")")"
case " $* " in *" --send "*) ;; *) export TXDB_CASHEW_SYNC_ONLY=1 ;; esac
exec python3 "$here/txdb" cashew-chromium sync "$@"
