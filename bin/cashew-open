#!/bin/bash
# cashew-open --hidden URL
# cashew-open --show URL [URL...]
#
# Opens URL in a NEW window of the default browser (Zen) and prints the window's address, so the widget can
# close it once Cashew has the rows.
#   --hidden  the window is placed on a hidden Hyprland workspace (special:cashew) the moment it appears,
#             and the keyboard focus stays where it was: nothing shows. A switchable window rule
#             (hl.window_rule, kept in the Lua global cashew_hide) is on only while the window opens, and
#             misc:focus_on_activate is off for 1.5 s so the browser cannot take the focus. Both are put
#             back by a trap, also on an error. Tested: a page in that window keeps its frames and timers.
#   --show    a normal, visible window; every further URL opens as a tab in that same window (all the
#             transfer pages at once: the person taps Save in each tab).
#
# Hyprland 0.56 takes Lua for dispatch: hyprctl dispatch 'hl.dsp.window.close({ window = "address:0x..." })'.
# The old form ("dispatch closewindow address:...") fails there without a sign.
#
# Exit 4: not possible here (no Hyprland, or the default browser is not Zen); open the link normally.
# Exit 5: no new window appeared within 5 s.
mode=$1
shift
url=$1
shift
[ -n "$url" ] || exit 2
command -v hyprctl >/dev/null 2>&1 || exit 4
command -v zen-browser >/dev/null 2>&1 || exit 4
[ "$(omarchy-cmd-default-browser 2>/dev/null)" = "zen.desktop" ] || exit 4

list() {
  hyprctl clients -j | python3 -I -c 'import json, sys
print(" ".join(c["address"] for c in json.load(sys.stdin) if c.get("class") == "zen"))'
}
before=" $(list) "

if [ "$mode" = "--hidden" ]; then
  activate=$(hyprctl getoption misc:focus_on_activate 2>/dev/null | sed -n 's/^bool: //p' | head -1)
  [ "$activate" = "false" ] || activate=true
  restore() {
    hyprctl eval 'if _G.cashew_hide then _G.cashew_hide:set_enabled(false) end' >/dev/null 2>&1
    hyprctl eval "hl.config({ misc = { focus_on_activate = $activate } })" >/dev/null 2>&1
  }
  trap restore EXIT
  hyprctl eval 'hl.config({ misc = { focus_on_activate = false } })
if not _G.cashew_hide then
  _G.cashew_hide = hl.window_rule({ match = { class = "^(zen)$" }, workspace = "special:cashew silent" })
end
_G.cashew_hide:set_enabled(true)' >/dev/null
fi

setsid zen-browser --new-window "$url" >/dev/null 2>&1 </dev/null &

new=""
for _ in $(seq 1 100); do
  for a in $(list); do
    case "$before" in *" $a "*) ;; *) new=$a ;; esac
  done
  [ -n "$new" ] && break
  sleep 0.05
done

if [ "$mode" = "--show" ] && [ -n "$new" ]; then
  # The new window is the active one now, so --new-tab puts the other pages next to the first.
  for more in "$@"; do
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$new\" })" >/dev/null 2>&1
    setsid zen-browser --new-tab "$more" >/dev/null 2>&1 </dev/null &
    sleep 0.4
  done
fi

if [ "$mode" = "--hidden" ]; then
  # The rule only for this window; the browser's own focus request can come a moment after it appears.
  hyprctl eval 'if _G.cashew_hide then _G.cashew_hide:set_enabled(false) end' >/dev/null 2>&1
  [ -n "$new" ] && hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:cashew\", follow = false, window = \"address:$new\" })" >/dev/null 2>&1
  sleep 1.5
fi
[ -n "$new" ] || exit 5
echo "$new"
