#!/bin/bash
# cashew-open-hidden URL
#
# Opens URL in a new window of the default browser on a hidden Hyprland workspace (special:cashew), gives
# the keyboard focus back to the window that had it, and prints the new window's address. The Cashew web
# app keeps running in a hidden window (frames and timers go on), so a link adds its rows without being
# seen. The window shows for a split second before it is moved.
#
# Exit 4: not possible here (no Hyprland, or the default browser is not Zen); open the link normally.
# Exit 5: no new window appeared within 5 s.
url=$1
[ -n "$url" ] || exit 2
command -v hyprctl >/dev/null 2>&1 || exit 4
command -v zen-browser >/dev/null 2>&1 || exit 4
[ "$(omarchy-cmd-default-browser 2>/dev/null)" = "zen.desktop" ] || exit 4

list() {
  hyprctl clients -j | python3 -I -c 'import json, sys
print(" ".join(c["address"] for c in json.load(sys.stdin) if c.get("class") == "zen"))'
}
prev=$(hyprctl activewindow -j | python3 -I -c 'import json, sys
d = json.load(sys.stdin) or {}
print(d.get("address", "") if isinstance(d, dict) else "")')
before=" $(list) "

setsid zen-browser --new-window "$url" >/dev/null 2>&1 </dev/null &

new=""
for _ in $(seq 1 100); do
  for a in $(list); do
    case "$before" in *" $a "*) ;; *) new=$a ;; esac
  done
  [ -n "$new" ] && break
  sleep 0.05
done
[ -n "$new" ] || exit 5

hyprctl dispatch movetoworkspacesilent "special:cashew,address:$new" >/dev/null
[ -n "$prev" ] && hyprctl dispatch focuswindow "address:$prev" >/dev/null
echo "$new"
